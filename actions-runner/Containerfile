# The upstream GitHub Actions runner image plus the OS packages the jobs on the self-hosted runners install at their start.
# A job that finds its packages installed does not touch the Ubuntu archive, so an archive that does not answer no longer
# fails it. The runner version is the version of image.yml, kept current by Renovate; it is also the tag of the base image.
ARG IMAGE_VERSION
FROM ghcr.io/actions/actions-runner:${IMAGE_VERSION}

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="actions-runner" \
      org.opencontainers.image.description="GitHub Actions runner with build tools, scanners and browser libraries preinstalled" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="guided-traffic.com" \
      org.opencontainers.image.source="https://github.com/guided-traffic/container-images"

# The base image runs as the user runner; packages need root.
USER root

# Security updates of the base image's packages, then the packages of the jobs. A package added here is one a job no longer
# fetches; a package a job needs and does not find here is still installed by that job, as before.
#
#   build-essential, file     make, the C compiler and file for builds with cgo and for the build scripts
#   jq, unzip, gettext-base   JSON and archive handling in job steps; envsubst for the cosign installer
#   libatomic1                needed by the Node.js binaries that actions/setup-node downloads
#   docker-compose-v2         the compose plugin for the Docker CLI of the base image
#   clamav, clamav-daemon     the malware scan of the sources (the signatures are still fetched by the job, with freshclam)
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        file \
        jq \
        unzip \
        gettext-base \
        libatomic1 \
        docker-compose-v2 \
        clamav \
        clamav-daemon \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The system libraries and fonts of Chromium, as Playwright 1.64 lists them for Ubuntu 24.04 ("playwright install --with-deps
# chromium"). The browser itself is not in the image: its version follows the Playwright version of each repository.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libasound2t64 \
        libatk-bridge2.0-0t64 \
        libatk1.0-0t64 \
        libatspi2.0-0t64 \
        libcairo2 \
        libcups2t64 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0t64 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        xvfb \
        fonts-noto-color-emoji \
        fonts-unifont \
        libfontconfig1 \
        libfreetype6 \
        xfonts-cyrillic \
        xfonts-scalable \
        fonts-liberation \
        fonts-ipafont-gothic \
        fonts-wqy-zenhei \
        fonts-tlwg-loma-otf \
        fonts-freefont-ttf \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Fail the build when a tool a job relies on is missing, instead of at the first job that needs it.
RUN make --version | head -n 1 && \
    gcc --version | head -n 1 && \
    file --version | head -n 1 && \
    jq --version && \
    unzip -v | head -n 1 && \
    envsubst --version | head -n 1 && \
    clamscan --version && \
    freshclam --version && \
    docker compose version

# Back to the user the runner starts as.
USER runner
