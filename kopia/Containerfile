# renovate: datasource=docker depName=debian versioning=docker
FROM debian:13.2-slim

# Build argument for Kopia version (passed from image.yml version)
ARG IMAGE_VERSION
ARG TARGETARCH

# Update package lists and install security updates
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y \
    ca-certificates \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Map Docker TARGETARCH to Kopia deb naming
# kopia uses amd64/arm64 which matches TARGETARCH directly
RUN curl -L -o /tmp/kopia.deb \
    "https://github.com/kopia/kopia/releases/download/v${IMAGE_VERSION}/kopia_${IMAGE_VERSION}_linux_${TARGETARCH}.deb" && \
    apt-get update && \
    apt-get install -y /tmp/kopia.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/*.deb

# Verify kopia installation
RUN kopia --version

# Create kopia user
RUN groupadd -r kopia && useradd -r -g kopia -m kopia

# Create config and cache directories
RUN mkdir -p /app/config /app/cache /app/data /app/logs && \
    chown -R kopia:kopia /app

# Copy entrypoint script
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Switch to non-root user
USER kopia

# Set working directory
WORKDIR /app

# Kopia server web UI port
EXPOSE 80

# Labels
LABEL org.opencontainers.image.title="Kopia" \
      org.opencontainers.image.description="Debian minimal container with Kopia backup tool and web UI" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="guided-traffic.com" \
      org.opencontainers.image.source="https://github.com/guided-traffic/container-images"

# Auto-connect to S3 repository on startup using env vars
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["sleep", "infinity"]
