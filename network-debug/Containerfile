# renovate: datasource=docker depName=ubuntu versioning=docker
FROM ubuntu:26.04

# Update package lists and install security updates
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    # Basic shell and utilities
    git \
    ntp \
    iptraf \
    sysstat \
    dkms \
    wget \
    curl \
    htop \
    ca-certificates \
    sed \
    net-tools \
    iw \
    iproute2 \
    wireless-tools \
    aptitude \
    vim \
    dnsutils \
    screen \
    telnet \
    iputils-ping \
    tcpdump \
    traceroute \
    gnupg \
    lsb-release \
    # Clean up package cache and development headers to reduce image size
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    # Remove unnecessary kernel headers that contain CVEs
    && dpkg -l | grep -i 'linux-libc-dev\|linux-headers' | awk '{print $2}' | xargs -r apt-get remove -y || true \
    && apt-get autoremove -y

CMD ["sleep", "infinity"]