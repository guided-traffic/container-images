# Ubuntu minimal base image with latest patches and etcd client
# renovate: datasource=docker depName=ubuntu versioning=docker
FROM ubuntu:26.04

# Build argument for etcd version (passed from image.yml version)
ARG IMAGE_VERSION
ARG TARGETARCH

# Set labels for container metadata
LABEL maintainer="guided-traffic.com"
LABEL description="Ubuntu minimal container with etcd client v${IMAGE_VERSION}"
LABEL version="${IMAGE_VERSION}"
LABEL etcd.version="${IMAGE_VERSION}"

# Update package lists and install security updates
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y \
    # Basic shell and utilities
    bash \
    curl \
    wget \
    ca-certificates \
    gnupg \
    lsb-release \
    # Clean up package cache to reduce image size
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install etcd client
# Use the version passed as build argument
ENV ETCD_VER=v${IMAGE_VERSION}
ENV GITHUB_URL=https://github.com/etcd-io/etcd/releases/download
ENV DOWNLOAD_URL=${GITHUB_URL}

RUN echo "Installing etcd version: ${ETCD_VER}" && \
    curl -L ${DOWNLOAD_URL}/${ETCD_VER}/etcd-${ETCD_VER}-linux-${TARGETARCH}.tar.gz -o /tmp/etcd-${ETCD_VER}-linux-${TARGETARCH}.tar.gz && \
    mkdir -p /tmp/etcd-download && \
    tar xzvf /tmp/etcd-${ETCD_VER}-linux-${TARGETARCH}.tar.gz -C /tmp/etcd-download --strip-components=1 && \
    cp /tmp/etcd-download/etcd /usr/local/bin/ && \
    cp /tmp/etcd-download/etcdctl /usr/local/bin/ && \
    cp /tmp/etcd-download/etcdutl /usr/local/bin/ && \
    rm -rf /tmp/etcd-download /tmp/etcd-${ETCD_VER}-linux-${TARGETARCH}.tar.gz

# Verify etcd client installation
RUN etcdctl version && etcd --version

# Create non-root user for security
RUN groupadd -r etcduser && useradd -r -g etcduser etcduser

# Set working directory
WORKDIR /app

# Change ownership of working directory
RUN chown -R etcduser:etcduser /app

# Switch to non-root user
USER etcduser

# Default shell
SHELL ["/bin/bash", "-c"]

# Default command starts an interactive shell
CMD ["/bin/bash"]
