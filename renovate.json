{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "branchPrefix": "renovate/",
  "labels": ["dependencies", "renovate"],
  "assignees": ["hans-fischer"],
  "reviewers": [],
  "packageRules": [
    {
      "description": "Group all container image updates together",
      "matchFileNames": ["**/image.yml"],
      "groupName": "container-images",
      "addLabels": ["container-updates"]
    },
    {
      "description": "Separate kubectl additional versions updates (do not group)",
      "matchFileNames": ["kubectl/additional_versions.yml"],
      "groupName": "kubectl-versions",
      "addLabels": ["kubectl", "container-updates"],
      "separateMinorPatch": true
    },
    {
      "description": "Pin Debian to version 12 (unapproved by Docker Scout)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["debian"],
      "matchFileNames": ["thanos/Containerfile"],
      "allowedVersions": "<=12",
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in image.yml files using inline renovate comments",
      "fileMatch": ["(^|/)image\\.ya?ml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\nversion:\\s*(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update kubectl patch versions in additional_versions.yml",
      "fileMatch": ["^kubectl/additional_versions\\.ya?ml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*- minor: \"(?<minor>\\d+\\.\\d+)\"\\s*\\n\\s*patch: \"(?<currentValue>\\d+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}",
      "currentValueTemplate": "{{minor}}.{{currentValue}}"
    }
  ]
}