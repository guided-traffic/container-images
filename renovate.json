{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "branchPrefix": "renovate/",
  "labels": ["dependencies", "renovate"],
  "assignees": ["hans-fischer"],
  "reviewers": [],
  "enabledManagers": ["regex"],
  "packageRules": [
    {
      "description": "Group all container image updates together",
      "matchFileNames": ["**/image.yml"],
      "groupName": "container-images",
      "addLabels": ["container-updates"]
    }
  ],
  "regexManagers": [
    {
      "description": "Update etcd version in etcd-client image.yml",
      "fileMatch": ["^etcd-client/image\\.ya?ml$"],
      "matchStrings": [
        "name:\\s*etcd-client\\s*\\nversion:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "etcd-io/etcd",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "Update Thanos version in thanos image.yml",
      "fileMatch": ["^thanos/image\\.ya?ml$"],
      "matchStrings": [
        "name:\\s*thanos\\s*\\nversion:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "thanos-io/thanos",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "Update kubectl version in kubectl image.yml",
      "fileMatch": ["^kubectl/image\\.ya?ml$"],
      "matchStrings": [
        "kubectl_version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "Update yq version in kubectl image.yml",
      "fileMatch": ["^kubectl/image\\.ya?ml$"],
      "matchStrings": [
        "yq_version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "mikefarah/yq",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "description": "Update kubectl patch versions in additional_versions.yml",
      "fileMatch": ["^kubectl/additional_versions\\.ya?ml$"],
      "matchStrings": [
        "minor:\\s*\"(?<currentMinor>\\d+\\.\\d+)\"\\s*\\n\\s*patch:\\s*\"(?<currentValue>\\d+)\"\\s*#"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "currentValueTemplate": "{{{currentMinor}}}.{{{currentValue}}}"
    },
    {
      "description": "Update base image versions in Containerfiles",
      "fileMatch": ["(^|/)Containerfile$"],
      "matchStrings": [
        "FROM\\s+(?<depName>ubuntu):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}