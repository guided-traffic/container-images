{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 5,
  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "assignees": [
    "hans-fischer"
  ],
  "reviewers": [],
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Auto-merge all updates when CI passes",
      "automerge": true
    },
    {
      "description": "Group all container image updates together",
      "matchFileNames": [
        "**/image.yml"
      ],
      "groupName": "container-images",
      "addLabels": [
        "container-updates"
      ]
    },
    {
      "description": "kubectl-1.34 - only allow 1.34.x patch updates",
      "matchFileNames": [
        "kubectl/additional_versions.yml"
      ],
      "matchDepNames": [
        "kubectl-1.34"
      ],
      "allowedVersions": "/^1\\.34\\..+$/",
      "addLabels": [
        "kubectl",
        "container-updates"
      ]
    },
    {
      "description": "kubectl-1.33 - only allow 1.33.x patch updates",
      "matchFileNames": [
        "kubectl/additional_versions.yml"
      ],
      "matchDepNames": [
        "kubectl-1.33"
      ],
      "allowedVersions": "/^1\\.33\\..+$/",
      "addLabels": [
        "kubectl",
        "container-updates"
      ]
    },
    {
      "description": "Pin Debian to version 12 (unapproved by Docker Scout)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "debian"
      ],
      "matchFileNames": [
        "thanos/Containerfile"
      ],
      "allowedVersions": "<=12",
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions in image.yml files using inline renovate comments",
      "managerFilePatterns": [
        "/(^|/)image\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\nversion:\\s*(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update kubectl patch versions in additional_versions.yml",
      "managerFilePatterns": [
        "/^kubectl/additional_versions\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*- version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "depNameTemplate": "{{{depName}}}",
      "packageNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "{{{datasource}}}"
    }
  ]
}
